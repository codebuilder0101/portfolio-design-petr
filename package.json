{
  "name": "frame-motion-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve.mjs",
    "media": "node scripts/build-media.mjs",
    "brand": "node scripts/build-brand.mjs",
    "assets": "npm run media && npm run brand",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
